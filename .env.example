# Copie este arquivo para .env e preencha com seus valores reais

# String de conexão do Neon PostgreSQL (Neon Console -> Connect -> Connection string)
# Exemplo com pooler para Vercel/serverless:
# postgresql://usuario:senha@ep-seu-projeto-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/neondb?sslmode=require"

# Segredo para assinar os cookies de sessão JWT (gere uma string longa e aleatória)
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"
